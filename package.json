{
  "name": "health-qc-monorepo",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "pnpm -r --filter ./apps/* run build",
    "dev": "pnpm --filter ./apps/medqc-web dev",
    "dev:yibao": "pnpm --filter ./apps/yibao-web dev",
    "dev:all": "concurrently -k -n medqc,yibao -c blue,green \"pnpm --filter ./apps/medqc-web dev -- --host 0.0.0.0 --port 3000\" \"pnpm --filter ./apps/yibao-web dev -- --host 0.0.0.0 --port 3001\"",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "concurrently": "8"
  }
}
