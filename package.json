{
  "name": "health-qc-monorepo",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "pnpm -r --filter ./apps/* run build",
    "dev": "pnpm --filter ./apps/medqc-web dev",
    "dev:medqc": "pnpm --filter ./apps/medqc-web dev -- --host 0.0.0.0 --port 3000",
    "dev:yibao": "pnpm --filter ./apps/yibao-web dev -- --host 0.0.0.0 --port 3008",
    "dev:all": "concurrently -k -n medqc,yibao -c blue,green \"pnpm --filter ./apps/medqc-web dev -- --host 0.0.0.0 --port 3000\" \"pnpm --filter ./apps/yibao-web dev -- --host 0.0.0.0 --port 3008\"",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "./dev-env.sh clean",
    "status": "./dev-env.sh status",
    "init": "./dev-env.sh init",
    "install:deps": "pnpm install",
    "test": "pnpm -r test",
    "test:medqc": "pnpm --filter ./apps/medqc-web test",
    "test:yibao": "pnpm --filter ./apps/yibao-web test:all",
    "gen:precise": "pnpm --filter ./apps/yibao-web exec tsc -p scripts/tsconfig.json && node scripts/dist/generate-precise-rule-pack.js",
    "prepare": "husky",
    "precommit": "corepack pnpm lint-staged --config ./package.json && corepack pnpm --filter ./apps/medqc-web run check:encoding",
    "quality:medqc": "corepack pnpm --filter ./apps/medqc-web run quality:ci"
  },
  "devDependencies": {
    "concurrently": "8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "lint-staged": {
    "apps/medqc-web/**/*.{js,jsx,ts,tsx,vue,cjs,mjs}": [
      "corepack pnpm --filter ./apps/medqc-web exec eslint --fix",
      "corepack pnpm --filter ./apps/medqc-web exec prettier --write"
    ],
    "apps/medqc-web/**/*.{json,md,yml,yaml,css,scss,less}": [
      "corepack pnpm --filter ./apps/medqc-web exec prettier --write"
    ]
  }
}
