# 医保质控系统 (YiBao) - 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改配置值

# ===========================================
# 🌐 应用基础配置
# ===========================================

# 应用名称
VITE_APP_NAME="医保质控系统"
VITE_APP_VERSION="1.0.0"

# 应用环境 (development | staging | production)
VITE_APP_ENV=development

# 前端服务端口
VITE_PORT=3008

# 是否启用严格端口模式
VITE_STRICT_PORT=true

# ===========================================
# 🔗 API 服务配置
# ===========================================

# 后端 API 基础地址
VITE_API_BASE_URL=http://localhost:8008

# API 超时时间 (毫秒)
VITE_API_TIMEOUT=30000

# 是否启用 API Mock
VITE_ENABLE_MOCK=false

# ===========================================
# 🏥 医保业务配置
# ===========================================

# 医保系统版本
YIBAO_SYSTEM_VERSION="2024.1"

# 医保地区编码
YIBAO_REGION_CODE="CN-BJ"

# 医保机构编码
YIBAO_ORG_CODE="BJ001"

# 医保结算系统接口
YIBAO_SETTLEMENT_API=https://api.yibao.gov.cn/settlement

# ===========================================
# 🗄️ 数据库配置
# ===========================================

# PostgreSQL 连接配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yibao_db
DB_USER=yibao_user
DB_PASSWORD=yibao_password

# 数据库连接池配置
DB_POOL_MIN=5
DB_POOL_MAX=20

# ===========================================
# 🔐 身份认证配置
# ===========================================

# JWT 密钥和过期时间
JWT_SECRET_KEY=your-yibao-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# 医保系统认证配置
YIBAO_AUTH_APP_ID=your-yibao-app-id
YIBAO_AUTH_APP_SECRET=your-yibao-app-secret
YIBAO_AUTH_CERT_PATH=./certs/yibao.pem

# ===========================================
# 🤖 AI/LLM 服务配置
# ===========================================

# 医保专用 LLM 配置
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo

# 医保规则分析专用模型
YIBAO_RULE_MODEL=gpt-4
YIBAO_REVIEW_MODEL=claude-3-haiku

# API 配置
OPENAI_API_KEY=your-openai-api-key-for-yibao
ANTHROPIC_API_KEY=your-anthropic-api-key-for-yibao

# ===========================================
# 💰 医保费用审核配置
# ===========================================

# 费用审核阈值配置
FEE_REVIEW_THRESHOLD_LOW=1000
FEE_REVIEW_THRESHOLD_MEDIUM=5000
FEE_REVIEW_THRESHOLD_HIGH=10000

# 自动审核规则
AUTO_REVIEW_ENABLED=true
AUTO_REVIEW_MAX_AMOUNT=2000

# 人工审核配置
MANUAL_REVIEW_REQUIRED_AMOUNT=50000
MANUAL_REVIEW_TIMEOUT_HOURS=72

# ===========================================
# 📋 医保目录配置
# ===========================================

# 药品目录数据源
DRUG_CATALOG_API=https://api.yibao.gov.cn/drugs
DRUG_CATALOG_UPDATE_INTERVAL=24h

# 诊疗项目目录
TREATMENT_CATALOG_API=https://api.yibao.gov.cn/treatments
TREATMENT_CATALOG_VERSION=2024-v1

# 医疗服务设施目录
FACILITY_CATALOG_API=https://api.yibao.gov.cn/facilities

# ===========================================
# 🔍 违规检测配置
# ===========================================

# 违规模式检测
FRAUD_DETECTION_ENABLED=true
FRAUD_DETECTION_MODEL=yibao-fraud-v2

# 异常费用检测阈值
ANOMALY_DETECTION_Z_SCORE=3.0
ANOMALY_DETECTION_MIN_SAMPLES=100

# 重复收费检测
DUPLICATE_CHARGE_DETECTION=true
DUPLICATE_TIME_WINDOW_HOURS=24

# ===========================================
# 📊 统计分析配置
# ===========================================

# 数据分析配置
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365

# 报表生成配置
REPORT_GENERATION_ENABLED=true
REPORT_STORAGE_PATH=./reports
REPORT_MAX_SIZE_MB=100

# ===========================================
# 📧 通知服务配置
# ===========================================

# 医保通知配置
YIBAO_NOTIFICATION_ENABLED=true
YIBAO_NOTIFICATION_API=https://notify.yibao.gov.cn

# 短信通知配置
SMS_PROVIDER=yibao_sms
SMS_TEMPLATE_AUDIT_PASS=YIBAO_AUDIT_PASS
SMS_TEMPLATE_AUDIT_REJECT=YIBAO_AUDIT_REJECT

# 邮件通知配置
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.yibao.gov.cn
EMAIL_SMTP_PORT=587

# ===========================================
# 📁 文件存储配置
# ===========================================

# 医保文档存储配置
DOC_STORAGE_TYPE=local
DOC_STORAGE_PATH=./storage/yibao-docs
DOC_MAX_SIZE_MB=20

# 影像资料存储
IMAGE_STORAGE_TYPE=oss
IMAGE_STORAGE_BUCKET=yibao-images
IMAGE_MAX_SIZE_MB=50

# 报告文件存储
REPORT_STORAGE_TYPE=local
REPORT_STORAGE_PATH=./storage/reports

# ===========================================
# 🚀 性能和缓存配置
# ===========================================

# Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# 医保数据缓存时间
YIBAO_CACHE_EXPIRE_HOURS=12
CATALOG_CACHE_EXPIRE_DAYS=1

# ===========================================
# 📝 审计日志配置
# ===========================================

# 审计日志级别
AUDIT_LOG_LEVEL=INFO

# 审计日志保留时间
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years as required by regulations

# 敏感操作记录
AUDIT_SENSITIVE_OPERATIONS=true
AUDIT_USER_ACTIONS=true
AUDIT_FEE_CHANGES=true

# ===========================================
# 🔧 开发调试配置
# ===========================================

# 开发模式配置
VITE_DEBUG=true
VITE_SHOW_MOCK_DATA=true

# 测试环境配置
TEST_MODE=false
TEST_DATA_ENABLED=true

# ===========================================
# 🏥 医院集成配置
# ===========================================

# HIS 系统集成
HIS_INTEGRATION_ENABLED=true
HIS_API_BASE_URL=http://localhost:9000
HIS_API_KEY=your-his-api-key

# PACS 系统集成
PACS_INTEGRATION_ENABLED=false
PACS_API_BASE_URL=http://localhost:9001

# LIS 系统集成
LIS_INTEGRATION_ENABLED=false
LIS_API_BASE_URL=http://localhost:9002

# ===========================================
# 🔒 安全配置
# ===========================================

# 数据加密配置
DATA_ENCRYPTION_ENABLED=true
DATA_ENCRYPTION_ALGORITHM=AES-256-GCM
DATA_ENCRYPTION_KEY=your-32-character-encryption-key

# 访问控制配置
ACCESS_CONTROL_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# IP 白名单配置
IP_WHITELIST_ENABLED=false
IP_WHITELIST=127.0.0.1,192.168.1.0/24

# ===========================================
# 🎯 功能开关
# ===========================================

# 医保特定功能开关
VITE_ENABLE_FEE_REVIEW=true
VITE_ENABLE_FRAUD_DETECTION=true
VITE_ENABLE_CATALOG_MANAGEMENT=true
VITE_ENABLE_SETTLEMENT=true

# 高级功能开关
VITE_ENABLE_AI_REVIEW=true
VITE_ENABLE_BATCH_PROCESSING=true
VITE_ENABLE_REAL_TIME_MONITORING=true

# 集成功能开关
VITE_ENABLE_HIS_INTEGRATION=true
VITE_ENABLE_GOVERNMENT_REPORTING=true

# ===========================================
# 🌍 地区化配置
# ===========================================

# 地区代码
REGION_CODE=110000  # 北京市代码
CITY_CODE=110100    # 北京市市辖区代码

# 地区特定规则版本
REGIONAL_RULES_VERSION=2024-BJ-v1

# 当地政策配置
LOCAL_POLICY_ENABLED=true
LOCAL_POLICY_VERSION=2024.1