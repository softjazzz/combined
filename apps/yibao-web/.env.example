# ================================
# 智慧医保质控系统环境变量配置示例
# ================================
# 使用说明:
# 1. 复制此文件为 .env（开发环境）
# 2. 或复制为 .env.production（生产环境）
# 3. 填写实际的配置值（不要提交真实密钥到版本控制）

# --------------------------------
# 后端 API 服务配置
# --------------------------------
# 后端 API 基础 URL
VITE_API_BASE_URL=http://localhost:8002

# 医保 API 服务器端口（默认: 8002）
YIBAO_API_PORT=8002

# --------------------------------
# 安全配置
# --------------------------------
# JWT 密钥（必填，生产环境必须使用强随机密钥）
# 可使用: openssl rand -hex 32 生成
JWT_SECRET=yibao-secret-key-change-in-production

# --------------------------------
# Supabase 配置
# --------------------------------
# Supabase 项目 URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 匿名密钥（公开密钥，可在前端使用）
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role 密钥（仅服务端使用，权限较高）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------
# 开发环境配置
# --------------------------------
# Node.js 环境（development / production / staging）
NODE_ENV=development

# 调试模式（true / false）
DEBUG=true
