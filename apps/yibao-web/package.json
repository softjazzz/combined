{
  "name": "@health-qc/yibao-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "backend": "cd backend && source venv/bin/activate && python3 main.py",
    "backend:install": "cd backend && pip install -r requirements.txt",
    "start:full": "concurrently \"npm run backend\" \"npm run dev\"",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:backend": "cd backend && python -m pytest tests/backend/ -v",
    "test:integration": "node tests/integration/test-complete-analytics.js",
    "test:e2e": "playwright test tests/e2e/",
    "test:all": "npm run test:unit && npm run test:backend && npm run test:integration"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.0",
    "ant-design-vue": "^4.2.5",
    "axios": "^1.6",
    "dayjs": "^1.11.10",
    "echarts": "^5.6.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.29",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "jsdom": "^26.1.0",
    "less": "^4.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.8",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.1.10"
  }
}
