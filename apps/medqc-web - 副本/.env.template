# 医疗质控系统 (MedQC) - 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改配置值

# ===========================================
# 🌐 应用基础配置
# ===========================================

# 应用名称
VITE_APP_NAME="医疗质控系统"
VITE_APP_VERSION="1.0.0"

# 应用环境 (development | staging | production)
VITE_APP_ENV=development

# 前端服务端口
VITE_PORT=3000

# 是否启用严格端口模式 (端口被占用时不自动尝试其他端口)
VITE_STRICT_PORT=true

# ===========================================
# 🔗 API 服务配置
# ===========================================

# 后端 API 基础地址
VITE_API_BASE_URL=http://localhost:8000

# API 超时时间 (毫秒)
VITE_API_TIMEOUT=30000

# 是否启用 API Mock
VITE_ENABLE_MOCK=false

# ===========================================
# 🗄️ 数据库配置
# ===========================================

# Supabase 项目地址 (如果使用 Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PostgreSQL 连接配置 (后端使用)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medqc_db
DB_USER=medqc_user
DB_PASSWORD=medqc_password

# ===========================================
# 🔐 身份认证配置
# ===========================================

# JWT 密钥和过期时间
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth 配置 (如果需要)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# 🤖 AI/LLM 服务配置
# ===========================================

# LLM 服务提供商 (openai | anthropic | local)
LLM_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Anthropic 配置
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# 本地 LLM 配置
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama2:7b

# ===========================================
# 📊 质控规则引擎配置
# ===========================================

# 规则引擎类型 (rule_based | ml_based | llm_based)
QC_ENGINE_TYPE=llm_based

# 质控评分阈值
QC_PASS_THRESHOLD=80
QC_WARNING_THRESHOLD=60

# 并发处理数量
QC_CONCURRENT_LIMIT=5

# ===========================================
# 📧 通知服务配置
# ===========================================

# 邮件服务配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@medqc.com

# 短信服务配置
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key

# ===========================================
# 📁 文件存储配置
# ===========================================

# 文件上传限制 (MB)
MAX_FILE_SIZE=50
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# 本地存储路径
LOCAL_UPLOAD_PATH=./uploads

# 云存储配置 (如果使用)
CLOUD_STORAGE_PROVIDER=aliyun_oss
CLOUD_STORAGE_BUCKET=medqc-files
CLOUD_STORAGE_REGION=oss-cn-beijing

# ===========================================
# 🚀 性能和缓存配置
# ===========================================

# Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 缓存过期时间 (秒)
CACHE_EXPIRE_TIME=3600

# ===========================================
# 📝 日志配置
# ===========================================

# 日志级别 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE_PATH=./logs/medqc.log

# 是否启用日志轮转
LOG_ROTATION=true
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# ===========================================
# 🔧 开发调试配置
# ===========================================

# 是否启用调试模式
VITE_DEBUG=true

# 是否显示详细错误信息
VITE_SHOW_ERROR_DETAILS=true

# 是否启用性能监控
VITE_ENABLE_PERFORMANCE_MONITOR=false

# 是否启用热重载
VITE_HOT_RELOAD=true

# ===========================================
# 🏥 业务特定配置
# ===========================================

# 医院信息
HOSPITAL_NAME="示例医院"
HOSPITAL_CODE="DEMO001"

# 科室默认配置
DEFAULT_DEPARTMENTS=内科,外科,儿科,妇产科,急诊科

# 质控规则版本
QC_RULES_VERSION=2024.1

# 是否启用专科化配置
ENABLE_DEPARTMENT_SPECIFIC_RULES=true

# ===========================================
# 🌍 国际化配置
# ===========================================

# 默认语言
VITE_DEFAULT_LOCALE=zh-CN

# 支持的语言列表
VITE_SUPPORTED_LOCALES=zh-CN,en-US

# 时区设置
TIMEZONE=Asia/Shanghai

# ===========================================
# 🔒 安全配置
# ===========================================

# CORS 允许的源
CORS_ORIGINS=http://localhost:3000,http://localhost:3008

# 是否启用 HTTPS (生产环境)
ENABLE_HTTPS=false

# SSL 证书路径 (生产环境)
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# 数据加密密钥
DATA_ENCRYPTION_KEY=your-data-encryption-key

# ===========================================
# 🎯 功能开关
# ===========================================

# 是否启用演示模式
VITE_ENABLE_DEMO_MODE=true

# 是否启用申诉功能
VITE_ENABLE_APPEAL_SYSTEM=true

# 是否启用通知系统
VITE_ENABLE_NOTIFICATION_SYSTEM=true

# 是否启用统计分析
VITE_ENABLE_ANALYTICS=true

# 是否启用导出功能
VITE_ENABLE_EXPORT=true