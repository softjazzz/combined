  border: 2px solid #e8e8e8;
  border-radius: 8px;
  padding: 16px;
  transition: all 0.3s;

  &.compliant {
    border-color: #52c41a;
    background: #f6ffed;
  }

  &.non-compliant {
    border-color: #ff4d4f;
    background: #fff1f0;
  }

  &.error {
    border-color: #faad14;
    background: #fffbe6;
  }

  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;

    .result-title {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;

      .result-icon {
        font-size: 20px;
      }

      .result-rule-id {
        font-size: 14px;
        font-weight: 600;
        color: #1890ff;
      }

      .result-rule-name {
        font-size: 14px;
        font-weight: 500;
        color: #333;
      }
    }

    .result-meta {
      display: flex;
      align-items: center;
      gap: 8px;

      .confidence {
        font-size: 12px;
        font-weight: 400;
        color: #8c8c8c;
      }
    }
  }

  .result-error {
    margin-bottom: 12px;
  }

  .result-issues {
    .issues-title {
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 8px;
      color: #333;
    }

    .issue-item {
      margin-bottom: 12px;
      padding-left: 8px;

      .issue-description {
        font-size: 14px;
        font-weight: 400;
        color: #333;
        margin-bottom: 4px;

        .issue-number {
          font-weight: 600;
          margin-right: 4px;
        }
      }

      .issue-evidence {
        font-size: 13px;
        font-weight: 400;
        color: #666;
        padding-left: 16px;
        border-left: 3px solid #e8e8e8;
        margin-left: 12px;

        .evidence-label {
          font-weight: 600;
          margin-right: 4px;
        }
      }
    }
  }

  .llm-output-section {
    margin-top: 12px;

    .llm-output {
      max-height: 200px;
      overflow-y: auto;
      background: #f5f5f5;
      padding: 12px;
      border-radius: 4px;
      font-family: 'Monaco', 'Menlo', 'Consolas', 'Courier New', monospace;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.5;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
  }
}

