const testSummary = computed(() => {
  if (testResults.value.length === 0) return ''
  const compliantCount = testResults.value.filter(r => r.isCompliant && !r.error).length
  const nonCompliantCount = testResults.value.filter(r => !r.isCompliant && !r.error).length
  const errorCount = testResults.value.filter(r => r.error).length
  return `${testResults.value.length}个质控点: ${compliantCount}个符合, ${nonCompliantCount}个发现问题${errorCount > 0 ? `, ${errorCount}个测试失败` : ''}`
})

const summaryColor = computed(() => {
  const nonCompliantCount = testResults.value.filter(r => !r.isCompliant && !r.error).length
  return nonCompliantCount === 0 ? 'success' : 'warning'
})

