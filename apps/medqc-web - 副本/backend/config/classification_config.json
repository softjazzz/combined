{
  "version": "enhanced",
  "fallback_version": "basic",
  "confidence_threshold": 0.5,
  "enable_advanced_features": true,
  "enable_multi_round_detection": true,
  "enable_surgery_record_detection": true,
  "enable_examination_report_detection": true,
  "max_processing_time": 30.0,
  "debug_mode": false,
  "performance_monitoring": true,
  "algorithm_settings": {
    "basic": {
      "confidence_threshold": 0.5,
      "max_documents": 10,
      "description": "基础关键词匹配算法，稳定可靠"
    },
    "enhanced": {
      "confidence_threshold": 0.5,
      "enable_hierarchical_classification": true,
      "description": "增强版分类算法，支持层级化分类"
    },
    "advanced": {
      "confidence_threshold": 0.5,
      "enable_advanced_features": true,
      "enable_multi_round_detection": true,
      "enable_surgery_record_detection": true,
      "enable_examination_report_detection": true,
      "max_rounds": 20,
      "description": "先进智能分类算法，支持多格式识别和高精度分类"
    }
  },
  "feature_flags": {
    "enable_version_switching": true,
    "enable_performance_monitoring": true,
    "enable_fallback_mechanism": true,
    "enable_result_validation": true
  },
  "performance_thresholds": {
    "max_processing_time": 30.0,
    "min_confidence_threshold": 0.3,
    "max_documents_per_request": 50
  },
  "logging": {
    "enable_debug_logging": false,
    "log_classification_results": true,
    "log_performance_metrics": true
  }
}
