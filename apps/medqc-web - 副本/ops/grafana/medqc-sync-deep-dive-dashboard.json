        {
          "expr": "sum by (job, env) (medqc_sync_window_success_runs_total{job=~\"$job\",env=~\"$env\"})",
          "legendFormat": "success {{job}}/{{env}}",
          "refId": "A"
        },
        {
          "expr": "sum by (job, env) (medqc_sync_window_failed_runs_total{job=~\"$job\",env=~\"$env\"})",
          "legendFormat": "failed {{job}}/{{env}}",
          "refId": "B"
        },
        {
          "expr": "sum by (job, env) (medqc_sync_backlog_estimate{job=~\"$job\",env=~\"$env\"})",
          "legendFormat": "backlog {{job}}/{{env}}",
          "refId": "C"
        }
      ],
      "title": "Sync Outcome & Backlog Trend",
      "type": "timeseries"
    },
    {
