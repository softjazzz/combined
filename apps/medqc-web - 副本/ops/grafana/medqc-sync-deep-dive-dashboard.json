      "targets": [
        {
          "expr": "(max(medqc_sync_window_success_runs_total{job=~\"$job\",env=~\"$env\"}) * 100) / clamp_min(max(medqc_sync_window_runs_total{job=~\"$job\",env=~\"$env\"}), 1)",
