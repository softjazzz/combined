# ================================
# 前端环境变量配置示例
# ================================
# 使用说明:
# 1. 复制此文件为 .env（开发环境）
# 2. 或复制为 .env.production（生产环境）
# 3. 填写实际的配置值（不要提交真实密钥到版本控制）

# --------------------------------
# Supabase 配置
# --------------------------------
# Supabase 项目 URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 匿名密钥（公开密钥，可在前端使用）
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --------------------------------
# 后端 API 配置
# --------------------------------
# 后端 API 基础 URL
VITE_API_BASE_URL=http://localhost:8000

# 后端 API 版本（可选）
VITE_API_VERSION=v1

# WebSocket 基础 URL（用于实时通知）
VITE_WS_BASE_URL=ws://localhost:8001

# --------------------------------
# LLM 服务配置
# --------------------------------
# DeepSeek 官方 API 密钥
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API 地址
VITE_DEEPSEEK_API_URL=https://api.deepseek.com

# DeepSeek 模型名称
VITE_DEEPSEEK_MODEL=deepseek-v4-flash

# --------------------------------
# 应用配置
# --------------------------------
# 应用名称
VITE_APP_NAME=病案质控系统

# 运行环境（development / production / staging）
VITE_ENV=development

# --------------------------------
# DRG 模块配置
# --------------------------------
# 是否使用 Mock 数据（true=使用 Mock，false=使用真实 API）
# 开发阶段建议设置为 true，可以快速验证前端功能
VITE_USE_DRG_MOCK=true

# DRG 默认地区版本（sichuan / beijing / national 等）
VITE_DRG_DEFAULT_REGION=sichuan

# --------------------------------
# 数据库直接连接配置（仅用于迁移脚本）
# --------------------------------
# PostgreSQL 数据库连接字符串
# 格式: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
