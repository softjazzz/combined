[Unit]
Description=Publish MedQC raw records to cdm.mr
After=medqc-ingest-extract.service

[Service]
Type=oneshot
User=medqc-ingest
Group=medqc-ingest
EnvironmentFile=/etc/medqc-ingest/medqc-ingest.env
ExecStart=/opt/medqc-ingest/bin/medqc-ingest publish --interface web.mr
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/medqc-ingest
