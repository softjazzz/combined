<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>MedQC v0.4只读/受理API模板；本机监听，须核验路径和账户后另行批准启用。</Description></RegistrationInfo>
  <Triggers><BootTrigger><Enabled>false</Enabled><Delay>PT1M</Delay></BootTrigger></Triggers>
  <Principals><Principal id="SyncAccount"><UserId>__RUN_AS_SID__</UserId><LogonType>__LOGON_TYPE__</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable><Enabled>false</Enabled>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure><Interval>PT1M</Interval><Count>3</Count></RestartOnFailure>
  </Settings>
  <Actions Context="SyncAccount"><Exec>
    <Command>__PYTHON_EXE__</Command>
    <Arguments>"__PACKAGE_ROOT__\tools\run_sync_control.py" --config "__API_CONFIG__" api</Arguments>
    <WorkingDirectory>__PACKAGE_ROOT__</WorkingDirectory>
  </Exec></Actions>
</Task>
