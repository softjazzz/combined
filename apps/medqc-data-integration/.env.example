# 非敏感运行配置
MEDQC_SOURCE_ADAPTER=odbc
MEDQC_CHUNK_SIZE=1000
MEDQC_STALE_BATCH_MINUTES=60
MEDQC_SOURCE_TIMEZONE=Asia/Shanghai

# Caché ODBC（Windows 64 位 InterSystems ODBC35）
MEDQC_CACHE_ODBC_DRIVER=InterSystems ODBC35
MEDQC_CACHE_HOST=
MEDQC_CACHE_PORT=1972
MEDQC_CACHE_NAMESPACE=
MEDQC_CACHE_USER=
MEDQC_CACHE_PASSWORD_FILE=

# 可选 JDBC 适配器（Linux）；仅在 MEDQC_SOURCE_ADAPTER=jdbc 时读取
MEDQC_CACHE_JDBC_DRIVER=com.intersystems.jdbc.IRISDriver
MEDQC_CACHE_JDBC_URL=
MEDQC_CACHE_JDBC_JARS=

# ingest PostgreSQL：只存 cache_raw / sync_ops
MEDQC_INGEST_PG_HOST=
MEDQC_INGEST_PG_PORT=5432
MEDQC_INGEST_PG_DATABASE=medqc_ingest
MEDQC_INGEST_PG_USER=
MEDQC_INGEST_PG_PASSWORD_FILE=

# CDM PostgreSQL：业务库，与 ingest 库分离
MEDQC_CDM_PG_HOST=
MEDQC_CDM_PG_PORT=5432
MEDQC_CDM_PG_DATABASE=medqc
MEDQC_CDM_PG_USER=
MEDQC_CDM_PG_PASSWORD_FILE=
