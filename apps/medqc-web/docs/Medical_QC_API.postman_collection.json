{
  "info": {
    "name": "医疗质控系统 API",
    "description": "医疗质控系统后端 API 接口集合，包含文件解析、智能导入、数据查询等功能",
    "version": "2.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8002",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "系统接口",
      "item": [
        {
          "name": "健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": []
        },
        {
          "name": "根路径信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "文件解析",
      "item": [
        {
          "name": "解析医疗文件",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "options",
                  "value": "{}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/parse-medical-file-public",
              "host": ["{{baseUrl}}"],
              "path": ["api", "parse-medical-file-public"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "医疗记录",
      "item": [
        {
          "name": "智能导入医疗记录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_name\": \"测试患者\",\n  \"content\": \"这是一个测试病历记录，用于验证智能导入功能。患者主诉：头痛3天。现病史：患者3天前无明显诱因出现头痛，呈持续性钝痛。\",\n  \"file_info\": {\n    \"filename\": \"test.txt\",\n    \"size\": 1024,\n    \"type\": \"text/plain\"\n  },\n  \"parse_result\": {\n    \"method\": \"文本导入\",\n    \"medical_info\": {\n      \"patient_age\": 45,\n      \"patient_gender\": \"男\",\n      \"diagnosis\": [\"头痛\"]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/smart-import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "smart-import"]
            }
          },
          "response": []
        },
        {
          "name": "创建医疗记录（完整版）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"record_number\": \"MR20250829001\",\n  \"patient_name\": \"张三\",\n  \"patient_id\": \"110101199001011234\",\n  \"patient_age\": 35,\n  \"patient_gender\": \"男\",\n  \"department_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"doctor_id\": \"22222222-2222-2222-2222-222222222222\",\n  \"record_type\": \"inpatient\",\n  \"diagnosis_primary\": \"高血压\",\n  \"diagnosis_secondary\": [\"糖尿病\", \"冠心病\"],\n  \"content\": \"详细病历内容...\",\n  \"priority_level\": 2,\n  \"tags\": [\"急诊\", \"重点关注\"],\n  \"metadata\": {\n    \"import_method\": \"manual\",\n    \"source\": \"HIS系统\"\n  },\n  \"created_by\": \"22222222-2222-2222-2222-222222222222\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medical-records",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical-records"]
            }
          },
          "response": []
        },
        {
          "name": "获取医疗记录列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/medical-records?page=1&page_size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical-records"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "pending",
                  "disabled": true
                },
                {
                  "key": "department_id",
                  "value": "11111111-1111-1111-1111-111111111111",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "获取单个医疗记录",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/medical-records/{{record_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medical-records", "{{record_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "调试接口",
      "item": [
        {
          "name": "创建测试数据",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/api/debug/create-test-data",
              "host": ["{{baseUrl}}"],
              "path": ["api", "debug", "create-test-data"]
            }
          },
          "response": []
        },
        {
          "name": "调试表信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/debug/tables",
              "host": ["{{baseUrl}}"],
              "path": ["api", "debug", "tables"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ]
}
