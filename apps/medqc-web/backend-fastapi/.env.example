# ============================================
# FastAPI 应用配置
# ============================================
APP_NAME=DRG Backend API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# API 配置
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# Supabase 数据库配置
# ============================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key

# 注意：后端使用 service_role key，具有完整权限
# 不要在前端暴露此密钥！

# ============================================
# LLM 配置（DeepSeek）
# ============================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-v3

# ============================================
# OpenDRG 配置
# ============================================
OPENDRG_DEFAULT_REGION=sichuan
OPENDRG_BASE_PAYMENT=14655.0

# 基准支付标准（各地区不同）：
# - 四川省 2024: 14655 元
# - 北京市 2024: 16800 元
# - 国家版: 根据具体地区设置

# ============================================
# 外部 DRG API 集成
# ============================================
DRG_API_URL=https://medchat.fun/api/drg-grouping
DRG_API_MODE=mock  # mock 或 remote (开启远程调用)
