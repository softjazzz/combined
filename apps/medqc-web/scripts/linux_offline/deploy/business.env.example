ENV=production
JWT_SECRET=REPLACE_WITH_LOCALLY_GENERATED_RANDOM_SECRET
DATA_SOURCE=pg
DB_SCHEMA_MODE=split
DB_SEARCH_PATH=sys,qc,cdm,public,legacy
DATABASE_URL=postgresql://medqc_business_app:REPLACE_PASSWORD@127.0.0.1:5432/medqc_business
MEDQC_STARTUP_MODE=normal
MEDQC_STARTUP_BACKGROUND_ENABLED=false
MEDQC_RESUME_QC_TASKS=false
QC_TASK_DISPATCH_MODE=legacy
QC_DISPATCH_STATE_DIR=/data/medqc/business/state/dispatch
QC_SC_RULE_SOURCE_MONITOR_ENABLED=false
LLM_LOCAL_TOKEN_BUDGET_ENABLED=false
LX0609_TOKEN_SPLIT_ENABLED=false
PRODUCT_ACTIVATION_REQUIRED=true
PRODUCT_ACTIVATION_STATE_PATH=/data/medqc/business/state/activation.json
CORS_ORIGINS=http://192.168.140.177
TZ=Asia/Shanghai

# CDM仅在另行验收后配置专用只读凭据；默认不连接。
CDM_DATABASE_URL=
CDM_PGPASSFILE=
