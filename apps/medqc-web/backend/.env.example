# ================================
# 后端环境变量示例
# ================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入真实配置，不要提交真实密钥
# 3. backend/.env 已被 apps/medqc-web/.gitignore 忽略

# --------------------------------
# 基础环境 / 安全
# --------------------------------
ENV=development
# 新任务默认仍由Web执行；系统设置中的运行开关保存后覆盖此默认值。
QC_TASK_DISPATCH_MODE=legacy
# Web、Publisher和Worker需指向同一持久目录；多主机需挂载同一个共享目录。
# 未配置时为各自backend/data/qc_dispatch_control，不能用于互不共享目录的部署。
# QC_DISPATCH_STATE_DIR=D:/medqc/data/qc_dispatch_control
# MQ地址、密钥和队列名仅由部署配置提供，后台界面不保存或展示。
# QC_RABBITMQ_URL=amqp://user:password@127.0.0.1:5672/medqc
# QC_RABBITMQ_EXCHANGE=qc.dispatch
# QC_RABBITMQ_QUEUE=qc.main
# QC_RABBITMQ_DEAD_QUEUE=qc.dead
JWT_SECRET=replace-with-a-random-secret

# 产品离线激活（客户正式部署设为 true；开发环境保持 false）
PRODUCT_ACTIVATION_REQUIRED=false
# 可选：覆盖默认的本机激活状态文件路径
# PRODUCT_ACTIVATION_STATE_PATH=C:/ProgramData/MedQC/license/activation.json
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 生产环境建议开启，启动期关键依赖异常会直接失败
STRICT_STARTUP_CHECKS=false

# --------------------------------
# CORS
# --------------------------------
# 支持 JSON 数组或逗号分隔字符串
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:4174","http://127.0.0.1:4174"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# --------------------------------
# 主服务数据源
# --------------------------------
# 当前默认走 PostgreSQL 适配层，支持值：pg
DATA_SOURCE=pg

# --------------------------------
# 表名兼容项
# --------------------------------
RECORDS_TABLE=medical_records
DOCUMENTS_TABLE=medical_documents

# --------------------------------
# LLM 统一配置（主服务实际使用）
# --------------------------------
LLM_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-dashscope-api-key-here
LLM_MODEL=qwen3.8-flash
# 正式质控二审/高风险跨文书规则裁决模型；未配置时运行时代码回退 LLM_MODEL。
LLM_ADJUDICATOR_MODEL=qwen3.8-flash
LLM_ENABLE_THINKING=true
LLM_THINKING_BUDGET=256
LLM_TIMEOUT_SECONDS=120
LLM_ENABLE_TRUNCATE=false
LLM_MAX_CONTENT_LENGTH=100000
LLM_ALLOW_MOCK_WHEN_UNCONFIGURED=false
# 页面默认选中的厂商；留空时使用代码默认 alibaba。
LLM_DEFAULT_PROVIDER=alibaba
# 当前环境允许暴露的 MaaS 厂商；留空时自动按 ENV 回退：
# production -> alibaba,deepseek,ollama
# 非 production -> alibaba,deepseek,siliconflow,ollama
LLM_VISIBLE_PROVIDERS=

# --------------------------------
# 字段映射 / 历史兼容别名
# --------------------------------
# field_mapper.py 会优先读取这些兼容键，其次回退到 LLM_*
# 一般保持与 LLM_* 一致即可
DASHSCOPE_API_KEY=
ALIYUN_DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
FIELD_MAPPER_MODEL=qwen3.5-35b-a3b

# SiliconFlow 主要用于 ICD 语义向量检索，field_mapper 也可能复用其密钥
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
# 仅少量测试/脚本读取，不属于主服务必填项
SILICONFLOW_API_ENDPOINT=https://api.siliconflow.cn/v1

# 内部 Ollama（OpenAI 兼容接口）
OLLAMA_API_ENDPOINT=http://192.168.140.177:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b-instruct

# 本地Strata由部署人员配置；后台只保存服务商、模型和运行参数，不保存地址或密钥。
# STRATA_API_ENDPOINT=http://strata.internal:8080/v1
# STRATA_MODEL=实际API模型名称（区分大小写）
# STRATA_API_KEY=
# 可选：不填时二审沿用后台选定的本地模型。
# STRATA_ADJUDICATOR_MODEL=
# STRATA_CASE_CACHE_MODE=off
# 独立请求观测，默认false；只记录白名单参数/成本，不启用前缀缓存或改变Thinking。
# LLM_REQUEST_OBSERVATION_ENABLED=false

# 06-01-04调用点双模型实验：默认关闭；地址／凭据只在Gateway配置，不写进此策略。
# 非off需明确experiment、candidate_profile/model/revision、reference_revision。
# shadow只观测；cascade显式选择local_openai＋Strata，或candidate_provider=alibaba的百炼双模型组合。
# 详见 docs/plans/2026-11-01-dual-model-exam-p0-p1.md，启用须另做真实模型质量验收。
LLM_EXAM_RESULT_ROUTING={}
# A0/A1事实冻结隔离由进程环境或内部scope控制，不从本文件自动读取：
# 启动前PowerShell示例：$env:LLM_EXPERIMENT_NAMESPACE='A0-run01'
# A1单独用'A1-run01'；标签不自动切换Thinking。未配置/空值保持原冻结路径。
# Gateway进程开关：默认true，同病例模型HTTP串行；false仅用于回滚旧FIFO，总资源上限仍为2。
# STRATA_CASE_MODEL_SEQUENTIAL=true
# 以下仅由Gateway进程读取：连续优先只调整准入，关闭后回到同病例串行的公平FIFO。
# STRATA_CASE_CONTINUATION_ENABLED=true
# 每轮至多4个HTTP（含Prime/重试），或30秒后向其他等待病例让出；不取消在途请求。
# STRATA_CASE_BURST_REQUESTS=4
# STRATA_CASE_TURN_SECONDS=30
# 等待者达到30秒不再被连续优先越过；仍受正在执行的HTTP耗时影响。
# STRATA_CASE_FAIR_WAIT_SECONDS=30
# 下一调用留50毫秒间隙，不占物理模型lease；有空闲第二槽时可运行另一病例。
# STRATA_CASE_IDLE_GRACE_SECONDS=0.05
# 双服务部署需同时配置Gateway；以下profile名必须在网关注册表真实存在。
# LLM_VISIBLE_PROVIDERS=alibaba,strata,ollama
# LLM_DISPATCH_MODE=gateway
# LLM_GATEWAY_URL=http://127.0.0.1:8765
# LLM_GATEWAY_TOKEN=由部署人员提供的至少32字符共享密钥
# LLM_GATEWAY_PROFILES={"alibaba":"alibaba_main","strata":"strata_main","ollama":"ollama_main"}
# 网关进程的LLM_GATEWAY_PROFILES_JSON是完整注册表，与上面的Provider->profile映射不同。
# 百炼与Strata分别绑定独立resource，Strata保持max_inflight=2。详见docs/plans/2026-10-30-strata-admin-provider-selection.md。

# 已兼容但不建议继续新增：SICHUAN_*（保留给历史配置迁移）
# SICHUAN_API_ENDPOINT=
# SICHUAN_API_KEY=
# SICHUAN_MODEL=
# SICHUAN_TIMEOUT_SECONDS=120
# SICHUAN_ENABLE_TRUNCATE=false
# SICHUAN_MAX_CONTENT_LENGTH=100000
# SICHUAN_ALLOW_MOCK_WHEN_UNCONFIGURED=false

# --------------------------------
# 主数据库（本地 PostgreSQL）
# --------------------------------
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/medqc
DB_SCHEMA_MODE=single
# split 模式建议使用：public,qc,sys,cdm,legacy
DB_SEARCH_PATH=public,qc,sys,cdm,legacy
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# --------------------------------
# 远端 DHC / ETL 同步
# --------------------------------
# 兼容旧逻辑：直接提供整条 URL
REMOTE_DB_URL=postgresql://user:password@192.168.140.4:5432/dhc-app
# 新逻辑推荐把密码拆到单独环境变量，再由 db_config.json 的 remote_password_ref=env:REMOTE_DB_PASSWORD 引用
REMOTE_DB_PASSWORD=
PG_SYNC_LOCK_KEY=2026032601

# 医嘱、检验直读 homology；病理报告独立启用，其他表沿用源 PG。
# 医嘱/检验先升级 Alembic 再启用。
# 与现有源 PG 共用主机、端口和凭据；机构映射必须按客户部署明确填写。
HOMOLOGY_SYNC_ENABLED=false
# 病理报告独立开关；不随上面的医嘱/检验开关启用，不切换其他文书。
HOMOLOGY_PATHOLOGY_REPORT_SYNC_ENABLED=false
HOMOLOGY_DATABASE=homology
HOMOLOGY_SCHEMA=graph3_homology
HOMOLOGY_SOURCE_INSTITUTE_ID=
HOMOLOGY_TARGET_INSTITUTE_ID=

# 客户样本病历同步（仅明细表级有限并发，不增加病例级并发）
SAMPLE_SYNC_INCREMENTAL_ENABLED=false
SAMPLE_SYNC_DETAIL_TABLE_WORKERS=3
SAMPLE_SYNC_DETAIL_TABLE_WORKERS_MAX=6
SAMPLE_SYNC_UPSERT_BATCH_SIZE=500
SAMPLE_SYNC_WATERMARK_OVERLAP_MINUTES=10

# --------------------------------
# Supabase 兼容项
# --------------------------------
# 主服务当前已使用 PostgreSQL 适配层，这些键仅保留给兼容路径/脚本
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --------------------------------
# 出站 HTTP 白名单
# --------------------------------
OUTBOUND_ALLOWLIST=api.deepseek.com,dashscope.aliyuncs.com,api.siliconflow.cn,127.0.0.1,localhost,192.168.140.177

# --------------------------------
# 健康检查 / Dashboard
# --------------------------------
HEALTH_CACHE_TTL_SECONDS=30
HEALTH_REMOTE_TIMEOUT_SECONDS=2.0
HEALTH_REMOTE_CHECK_ENABLED=false
DASHBOARD_DB_STATS_TIMEOUT_SECONDS=2.0

# --------------------------------
# ICD 语义检索
# --------------------------------
ICD_SEMANTIC_ENABLED=false
ICD_SEMANTIC_TOP_K=5
ICD_SEMANTIC_T_HIGH=0.90
ICD_SEMANTIC_T_LOW=0.60
ICD_SEMANTIC_BACKEND=tfidf
ICD_SEMANTIC_INDEX_DIR=data/vector
ICD_SEMANTIC_EMBED_MODEL=BAAI/bge-m3
ICD_SEMANTIC_API_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
ICD_SEMANTIC_API_KEY=your-siliconflow-api-key-here
ICD_SEMANTIC_TIMEOUT_SECONDS=30

# --------------------------------
# Mongo 增量同步
# --------------------------------
MONGO_URI=
MONGO_DATABASE=his_emr
MONGO_SYNC_ENABLED=false
MONGO_SYNC_LOCK_KEY=2026032602

# --------------------------------
# DRG 批处理
# --------------------------------
DRG_BATCH_MAX_QUEUE_SIZE=20
DRG_BATCH_MAX_RUNNING_TASKS=1
DRG_BATCH_MAX_PENDING_PER_OWNER=2
DRG_BATCH_MAX_RUNNING_PER_OWNER=1

# --------------------------------
# 外部编码服务
# --------------------------------
EXTERNAL_CODING_USE_REMOTE=false
EXTERNAL_CODING_URL=http://122.51.111.253:8002
EXTERNAL_CODING_MAX_SECONDS=25

# --------------------------------
# Demo 路由专用 LLM 覆盖
# --------------------------------
DEMO_RULE_LLM_ENDPOINT=
DEMO_RULE_LLM_API_KEY=
DEMO_RULE_LLM_MODEL=

# --------------------------------
# OpenTelemetry
# --------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=medqc-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# --------------------------------
# 说明：以下旧键当前不属于 backend/app 主运行路径
# --------------------------------
# API_PORT / HOST / DEBUG：旧入口 main.py 使用，app/main.py 不再读取
# DRY_RUN / SEED_CREATED_BY：仅脚本使用
# VITE_DEEPSEEK_API_KEY / VITE_DEEPSEEK_API_URL：测试/历史脚本使用
