# ================================
# 后端环境变量示例
# ================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入真实配置，不要提交真实密钥
# 3. backend/.env 已被 apps/medqc-web/.gitignore 忽略

# --------------------------------
# 基础环境 / 安全
# --------------------------------
ENV=development
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 生产环境建议开启，启动期关键依赖异常会直接失败
STRICT_STARTUP_CHECKS=false

# --------------------------------
# CORS
# --------------------------------
# 支持 JSON 数组或逗号分隔字符串
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:4174","http://127.0.0.1:4174"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# --------------------------------
# 主服务数据源
# --------------------------------
# 当前默认走 PostgreSQL 适配层，支持值：pg
DATA_SOURCE=pg

# --------------------------------
# 表名兼容项
# --------------------------------
RECORDS_TABLE=medical_records
DOCUMENTS_TABLE=medical_documents

# --------------------------------
# LLM 统一配置（主服务实际使用）
# --------------------------------
LLM_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=qwen3.5-35b-a3b
LLM_TIMEOUT_SECONDS=120
LLM_ENABLE_TRUNCATE=false
LLM_MAX_CONTENT_LENGTH=100000
LLM_ALLOW_MOCK_WHEN_UNCONFIGURED=false

# --------------------------------
# 字段映射 / 历史兼容别名
# --------------------------------
# field_mapper.py 会优先读取这些兼容键，其次回退到 LLM_*
# 一般保持与 LLM_* 一致即可
DASHSCOPE_API_KEY=your-llm-api-key-here
ALIYUN_DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FIELD_MAPPER_MODEL=qwen3.5-35b-a3b

# SiliconFlow 主要用于 ICD 语义向量检索，field_mapper 也可能复用其密钥
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
# 仅少量测试/脚本读取，不属于主服务必填项
SILICONFLOW_API_ENDPOINT=https://api.siliconflow.cn/v1

# 内部 Ollama（OpenAI 兼容接口）
OLLAMA_API_ENDPOINT=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b-instruct

# 已兼容但不建议继续新增：SICHUAN_*（保留给历史配置迁移）
# SICHUAN_API_ENDPOINT=
# SICHUAN_API_KEY=
# SICHUAN_MODEL=
# SICHUAN_TIMEOUT_SECONDS=120
# SICHUAN_ENABLE_TRUNCATE=false
# SICHUAN_MAX_CONTENT_LENGTH=100000
# SICHUAN_ALLOW_MOCK_WHEN_UNCONFIGURED=false

# --------------------------------
# 主数据库（本地 PostgreSQL）
# --------------------------------
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/medqc
DB_SCHEMA_MODE=single
# split 模式建议使用：public,qc,sys,cdm,legacy
DB_SEARCH_PATH=public,qc,sys,cdm,legacy
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# --------------------------------
# 远端 DHC / ETL 同步
# --------------------------------
# 兼容旧逻辑：直接提供整条 URL
REMOTE_DB_URL=postgresql://user:password@192.168.140.4:5432/dhc-app
# 新逻辑推荐把密码拆到单独环境变量，再由 db_config.json 的 remote_password_ref=env:REMOTE_DB_PASSWORD 引用
REMOTE_DB_PASSWORD=
PG_SYNC_LOCK_KEY=2026032601

# --------------------------------
# Supabase 兼容项
# --------------------------------
# 主服务当前已使用 PostgreSQL 适配层，这些键仅保留给兼容路径/脚本
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --------------------------------
# 出站 HTTP 白名单
# --------------------------------
OUTBOUND_ALLOWLIST=dashscope.aliyuncs.com,api.siliconflow.cn,127.0.0.1,localhost

# --------------------------------
# 健康检查 / Dashboard
# --------------------------------
HEALTH_CACHE_TTL_SECONDS=30
HEALTH_REMOTE_TIMEOUT_SECONDS=2.0
HEALTH_REMOTE_CHECK_ENABLED=false
DASHBOARD_DB_STATS_TIMEOUT_SECONDS=2.0

# --------------------------------
# ICD 语义检索
# --------------------------------
ICD_SEMANTIC_ENABLED=false
ICD_SEMANTIC_TOP_K=5
ICD_SEMANTIC_T_HIGH=0.90
ICD_SEMANTIC_T_LOW=0.60
ICD_SEMANTIC_BACKEND=tfidf
ICD_SEMANTIC_INDEX_DIR=data/vector
ICD_SEMANTIC_EMBED_MODEL=BAAI/bge-m3
ICD_SEMANTIC_API_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
ICD_SEMANTIC_API_KEY=your-siliconflow-api-key-here
ICD_SEMANTIC_TIMEOUT_SECONDS=30

# --------------------------------
# Mongo 增量同步
# --------------------------------
MONGO_URI=
MONGO_DATABASE=his_emr
MONGO_SYNC_ENABLED=false
MONGO_SYNC_LOCK_KEY=2026032602

# --------------------------------
# DRG 批处理
# --------------------------------
DRG_BATCH_MAX_QUEUE_SIZE=20
DRG_BATCH_MAX_RUNNING_TASKS=1
DRG_BATCH_MAX_PENDING_PER_OWNER=2
DRG_BATCH_MAX_RUNNING_PER_OWNER=1

# --------------------------------
# 外部编码服务
# --------------------------------
EXTERNAL_CODING_USE_REMOTE=false
EXTERNAL_CODING_URL=http://122.51.111.253:8002
EXTERNAL_CODING_MAX_SECONDS=25

# --------------------------------
# Demo 路由专用 LLM 覆盖
# --------------------------------
DEMO_RULE_LLM_ENDPOINT=
DEMO_RULE_LLM_API_KEY=
DEMO_RULE_LLM_MODEL=

# --------------------------------
# OpenTelemetry
# --------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=medqc-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# --------------------------------
# 说明：以下旧键当前不属于 backend/app 主运行路径
# --------------------------------
# API_PORT / HOST / DEBUG：旧入口 main.py 使用，app/main.py 不再读取
# DRY_RUN / SEED_CREATED_BY：仅脚本使用
# VITE_DEEPSEEK_API_KEY / VITE_DEEPSEEK_API_URL：测试/历史脚本使用
