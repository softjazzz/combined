# ================================
# 后端环境变量配置示例
# ================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 填写实际的配置值（不要提交真实密钥到版本控制）
# 3. 确保 .env 文件在 .gitignore 中

# --------------------------------
# 安全配置
# --------------------------------
# JWT 密钥（必填，用于生成和验证 JWT token）
# 生产环境必须使用强随机密钥，可使用: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-change-in-production

# JWT 算法（默认: HS256）
JWT_ALGORITHM=HS256

# Access Token 过期时间（分钟，默认: 30）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --------------------------------
# CORS 配置
# --------------------------------
# 允许的跨域来源（JSON 数组格式或逗号分隔）
# 示例1（JSON数组）: ["http://localhost:3000","http://localhost:5173"]
# 示例2（逗号分隔）: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:4174","http://127.0.0.1:4174"]

# 是否允许携带凭证（默认: true）
CORS_ALLOW_CREDENTIALS=true

# 允许的 HTTP 方法（默认: ["*"]）
CORS_ALLOW_METHODS=["*"]

# 允许的 HTTP 头（默认: ["*"]）
CORS_ALLOW_HEADERS=["*"]

# --------------------------------
# Supabase 配置
# --------------------------------
# Supabase 项目 URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 匿名密钥
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role 密钥（仅服务端使用，权限较高）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------
# 数据库表配置
# --------------------------------
# 病历记录表名（默认: medical_records_test）
RECORDS_TABLE=medical_records_test

# 医疗文档表名（默认: medical_documents_test）
DOCUMENTS_TABLE=medical_documents_test

# --------------------------------
# 环境配置
# --------------------------------
# 运行环境（development / production / staging）
ENV=development

# API 服务器端口（默认: 8000，根据 DEVELOPMENT_PORTS.md 标准）
API_PORT=8000

# API 服务器主机（默认: 0.0.0.0）
HOST=0.0.0.0

# 调试模式（true / false）
DEBUG=true

# --------------------------------
# 四川质控 API 配置（可选）
# --------------------------------
# 四川质控 API 端点
SICHUAN_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1

# 四川质控 API 密钥
SICHUAN_API_KEY=your-sichuan-api-key-here

# 四川质控模型名称（默认: qwen2.5-14b-instruct）
SICHUAN_MODEL=qwen2.5-14b-instruct

# 四川质控 API 超时时间（秒，默认: 120）
SICHUAN_TIMEOUT_SECONDS=120

# --------------------------------
# 外部 HTTP 请求白名单
# --------------------------------
# 允许访问的外部域名列表（逗号分隔）
OUTBOUND_ALLOWLIST=dashscope.aliyuncs.com

# --------------------------------
# 数据库种子数据配置（可选）
# --------------------------------
# 种子数据创建者 ID（避免外键约束失败）
SEED_CREATED_BY=00000000-0000-0000-0000-000000000000

# 是否为 Dry Run 模式（true / false）
DRY_RUN=false

# --------------------------------
# LLM 服务配置（用于某些脚本）
# --------------------------------
# DeepSeek API 密钥
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API 地址
VITE_DEEPSEEK_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --------------------------------
# 数据库连接（用于迁移脚本）
# --------------------------------
# PostgreSQL 数据库连接字符串
# 格式: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
