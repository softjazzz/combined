# ================================
# 后端环境变量配置示例
# ================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 填写实际的配置值（不要提交真实密钥到版本控制）
# 3. 确保 .env 文件在 .gitignore 中

# --------------------------------
# 安全配置
# --------------------------------
# JWT 密钥（必填，用于生成和验证 JWT token）
# 生产环境必须使用强随机密钥，可使用: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-change-in-production

# JWT 算法（默认: HS256）
JWT_ALGORITHM=HS256

# Access Token 过期时间（分钟，默认: 30）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --------------------------------
# CORS 配置
# --------------------------------
# 允许的跨域来源（JSON 数组格式或逗号分隔）
# 示例1（JSON数组）: ["http://localhost:3000","http://localhost:5173"]
# 示例2（逗号分隔）: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:4174","http://127.0.0.1:4174"]

# 是否允许携带凭证（默认: true）
CORS_ALLOW_CREDENTIALS=true

# 允许的 HTTP 方法（默认: ["*"]）
CORS_ALLOW_METHODS=["*"]

# 允许的 HTTP 头（默认: ["*"]）
CORS_ALLOW_HEADERS=["*"]

# --------------------------------
# Supabase 配置
# --------------------------------
# Supabase 项目 URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 匿名密钥
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role 密钥（仅服务端使用，权限较高）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------
# 数据库表配置
# --------------------------------
# 病历记录表名（默认: medical_records）
RECORDS_TABLE=medical_records

# 医疗文档表名（默认: medical_documents）
DOCUMENTS_TABLE=medical_documents

# --------------------------------
# 环境配置
# --------------------------------
# 运行环境（development / production / staging）
ENV=development

# API 服务器端口（默认: 8000，根据 DEVELOPMENT_PORTS.md 标准）
API_PORT=8000

# API 服务器主机（默认: 0.0.0.0）
HOST=0.0.0.0

# 调试模式（true / false）
DEBUG=true

# --------------------------------
# LLM API 配置（统一命名）
# --------------------------------
# LLM API 端点
LLM_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM API 密钥
LLM_API_KEY=your-llm-api-key-here

# LLM 模型名称
LLM_MODEL=qwen3-next-80b-a3b-instruct

# LLM API 超时时间（秒，默认: 120）
LLM_TIMEOUT_SECONDS=120

# --------------------------------
# ICD 瀵瑰簲缂栫爜璇箟妫€绱㈠厹搴曪紙鍏抽棴锛孎alse锛?
# --------------------------------
ICD_SEMANTIC_ENABLED=false
ICD_SEMANTIC_TOP_K=5
ICD_SEMANTIC_T_HIGH=0.90
ICD_SEMANTIC_T_LOW=0.60
ICD_SEMANTIC_BACKEND=faiss
ICD_SEMANTIC_INDEX_DIR=data/vector
ICD_SEMANTIC_EMBED_MODEL=BAAI/bge-m3
ICD_SEMANTIC_API_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
ICD_SEMANTIC_API_KEY=your-siliconflow-api-key-here


# --------------------------------
# 外部 HTTP 请求白名单
# --------------------------------
# 允许访问的外部域名列表（逗号分隔）
OUTBOUND_ALLOWLIST=dashscope.aliyuncs.com

# --------------------------------
# 数据库种子数据配置（可选）
# --------------------------------
# 种子数据创建者 ID（避免外键约束失败）
SEED_CREATED_BY=00000000-0000-0000-0000-000000000000

# 是否为 Dry Run 模式（true / false）
DRY_RUN=false

# --------------------------------
# LLM 服务配置（用于某些脚本）
# --------------------------------
# DeepSeek API 密钥
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API 地址
VITE_DEEPSEEK_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --------------------------------
# 数据库连接（用于迁移脚本）
# --------------------------------
# PostgreSQL 数据库连接字符串
# 格式: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# --------------------------------
# PG Schema 隔离（可选）
# --------------------------------
# single = 所有表在 public schema（演示/开发，默认）
# split  = 按 qc/sys/cdm/legacy 分 schema（生产）
DB_SCHEMA_MODE=single
# split 模式下的搜索路径（仅 split 生效，默认: public,qc,sys,cdm,legacy）
# DB_SEARCH_PATH=public,qc,sys,cdm,legacy

# ================================
# 环境预设参考（复制对应段落到 .env）
# ================================
#
# --- Demo 环境（演示用，mock seed 数据）---
# DATABASE_URL=postgresql://postgres:xxx@localhost:5432/medqc_demo
# DB_SCHEMA_MODE=single
# ENV=development
#
# --- Prod 环境（生产用，Mongo 同步入 PG）---
# DATABASE_URL=postgresql://postgres:xxx@db.prod.supabase.co:5432/medqc_prod
# DB_SCHEMA_MODE=split
# DB_SEARCH_PATH=public,qc,sys,cdm,legacy
# ENV=production
