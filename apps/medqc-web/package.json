{
  "name": "medical-qc-system",
  "version": "1.0.0",
  "description": "病案质控系统 - 基于AI的医疗病案质量控制平台",
  "type": "module",
  "scripts": {
    "predev": "node scripts/run-predev.mjs",
    "dev": "vite --config vite.config.mjs",
    "cache:clean": "node scripts/reset-vite-cache.mjs",
    "dev:force": "npm run cache:clean && npm run styles:prebuild && vite --force --config vite.config.mjs",
    "styles:prebuild": "tailwindcss -i ./src/styles/index.css -o ./src/styles/index.prebuilt.css --minify",
    "build": "vite build --config vite.config.mjs --configLoader native",
    "build:profile": "node scripts/build-profile.mjs --runs=3",
    "build:analyze": "node scripts/build-profile.mjs --runs=1 --visualize",
    "preview": "vite preview --config vite.config.mjs --configLoader native",
    "type-check": "vue-tsc --noEmit",
    "type-check:release": "tsc --noEmit -p tsconfig.release.json",
    "test:unit:release": "vitest run --config vitest.release.config.mjs src/api/__tests__/qc.spec.ts src/api/__tests__/panel.spec.ts src/utils/__tests__/api-envelope.spec.ts",
    "type-check:acceptance": "npm run build",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:unit:coverage:acceptance": "vitest run --config vitest.acceptance.config.ts --coverage",
    "test:frontpage-m2": "powershell -NoProfile -Command \"Set-Location backend; py -3.10 -m pytest tests/unit/test_frontpage_router_api_postprocess.py tests/unit/test_frontpage_router_postprocess.py tests/unit/test_local_icd_semantic.py -q\"",
    "icd:index:build": "powershell -NoProfile -Command \"Set-Location backend; py -3.10 scripts/build_icd_vector_index.py --engine faiss --batch-size 64\"",
    "test:backend:acceptance": "node scripts/check-backend-prdv3-acceptance.mjs",
    "test:acceptance:6.3.1": "node scripts/run-drg-631-acceptance.mjs",
    "test:e2e": "playwright test",
    "db:init-base": "node --import tsx scripts/init-base-schema.ts",
    "db:migrate": "node --import tsx scripts/run-migration.ts",
    "db:init-rules": "node --import tsx scripts/init-qc-rules.ts",
    "db:seed": "node --import tsx scripts/init-qc-rules.ts --test-data",
    "verify-schema": "node --import tsx scripts/verify-schema.ts",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:encoding:all": "node scripts/check-encoding.mjs --all",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "perf:baseline": "node scripts/perf/run-perf-baseline.mjs",
    "perf:baseline:mock": "node scripts/perf/run-perf-baseline.mjs --mock",
    "perf:finalize": "node scripts/perf/finalize-capacity.mjs",
    "perf:finalize:mock": "node scripts/perf/finalize-capacity.mjs --mock",
    "type-check:strict": "vue-tsc --noEmit -p tsconfig.strict.json",
    "quality:ci": "npm run check:encoding && npm run type-check && npm run test:unit",
    "test:sichuan-rules:regression": "node scripts/run-sichuan-regression-check.mjs",
    "test:sichuan-rules:regression:strict": "node scripts/run-sichuan-regression-check.mjs --required",
    "quality:ci:sichuan": "npm run quality:ci && npm run test:sichuan-rules:regression",
    "quality:ci:sichuan:strict": "npm run quality:ci && npm run test:sichuan-rules:regression:strict",
    "test:ai": "node --import tsx scripts/test-ai-analysis.ts",
    "test:deepseek": "node --import tsx scripts/test-deepseek-api.ts",
    "test:qc": "node --import tsx scripts/test-qc-analysis.ts",
    "test:workflow": "node --import tsx scripts/test-full-workflow.ts",
    "init-comprehensive-rules": "node --import tsx scripts/init-comprehensive-rules.ts",
    "setup-rules-system": "node --import tsx scripts/setup-rules-system.ts",
    "check-work-rules": "node --import tsx scripts/check-work-rules.ts",
    "db:init-drg": "node --import tsx scripts/migrations/create-drg-tables.ts",
    "db:verify-drg": "node --import tsx scripts/migrations/verify-drg-tables.ts",
    "db:import-icd": "node --import tsx scripts/migrations/import-icd-codes.ts",
    "setup": "npm run db:init-base && npm run verify-schema && npm run db:migrate && npm run db:init-rules && npm run init-comprehensive-rules",
    "build:check": "vue-tsc --noEmit && vite build --config vite.config.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@supabase/supabase-js": "^2.57.4",
    "@types/crypto-js": "^4.2.2",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.11.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lodash-es": "^4.17.21",
    "mammoth": "^1.10.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.17.11",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-istanbul": "^2.1.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.2",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "less": "^4.4.1",
    "playwright": "^1.49.1",
    "postcss": "^8.5.3",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.93.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.20.3",
    "typescript": "~5.7.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
