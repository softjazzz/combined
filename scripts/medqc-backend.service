[Unit]
Description=MedQC Backend FastAPI Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/coding/health-qc-monorepo/apps/medqc-web/backend
Environment="PATH=/home/ubuntu/coding/health-qc-monorepo/apps/medqc-web/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/coding/health-qc-monorepo/apps/medqc-web/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/coding/health-qc-monorepo/apps/medqc-web/backend/backend.log
StandardError=append:/home/ubuntu/coding/health-qc-monorepo/apps/medqc-web/backend/backend.log

[Install]
WantedBy=multi-user.target
