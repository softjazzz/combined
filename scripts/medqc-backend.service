[Unit]
Description=MedQC Backend FastAPI Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/medqc/current/backend
EnvironmentFile=-/opt/medqc/shared/backend.env
Environment="PATH=/opt/medqc/current/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="ENV=production"
Environment="STRICT_STARTUP_CHECKS=true"
ExecStart=/opt/medqc/current/scripts/run_backend_prod.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=medqc-backend

[Install]
WantedBy=multi-user.target
