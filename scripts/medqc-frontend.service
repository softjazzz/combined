[Unit]
Description=MedQC Frontend Static Service
After=network.target medqc-backend.service
Wants=medqc-backend.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/medqc/current/frontend
EnvironmentFile=-/opt/medqc/shared/frontend.env
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/medqc/current/scripts/run_frontend_prod.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=medqc-frontend

[Install]
WantedBy=multi-user.target
