## 六、监控和质量保障

### 6.1 埋点方案

```python
import logging
from datetime import datetime

class QCMetrics:
    """质控指标监控"""
    
    @staticmethod
    def track_execution(result: Dict, duration_ms: int):
        """记录每次执行"""
        log_data = {
            "timestamp": datetime.now().isoformat(),
            "rule_id": result["rule_id"],
            "status": result["status"],
            "confidence": result["confidence"],
            "evidence_count": len(result["evidence"]),
            "evidence_verified": sum(
                1 for e in result["evidence"] if e["verified"]
            ),
            "duration_ms": duration_ms,
            "tokens_used": result["metadata"].get("tokens_used", 0),
            "applicability_method": result["applicability"]["method"],
            "shortcut": result["metadata"].get("shortcut", False)
        }
        
        # 发送到监控系统（如 Prometheus、Datadog）
        metrics.increment("qc.execution.total", tags={
            "status": result["status"],
            "rule_id": result["rule_id"]
        })
        
        metrics.histogram("qc.duration_ms", duration_ms, tags={
            "rule_id": result["rule_id"]
        })
        
        metrics.histogram("qc.confidence", result["confidence"], tags={
            "status": result["status"]
        })
        
        # 幻觉检测
        if result["evidence"]:
            hallucination_rate = 1 - (log_data["evidence_verified"] / log_data["evidence_count"])
            if hallucination_rate > 0.3:
                logging.warning(f"High hallucination rate detected: {hallucination_rate:.2%}")
                metrics.increment("qc.hallucination.high_risk", tags={
                    "rule_id": result["rule_id"]
                })
        
        return log_data
```

