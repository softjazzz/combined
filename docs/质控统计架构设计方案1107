// 汇总统计组件
function QCSummary({ results }: { results: QCResult[] }) {
  const stats = results.reduce((acc, r) => {
    acc[r.status] = (acc[r.status] || 0) + 1;
    return acc;
  }, {} as Record<string, number>);
  
  return (
    <div className="bg-white rounded-lg shadow p-6 mb-4">
      <h2 className="text-xl font-bold mb-4">质控结果概览</h2>
      <div className="grid grid-cols-4 gap-4">
        <StatCard 
          label="合规" 
          count={stats.compliant || 0} 
          color="green"
          icon="✓"
        />
        <StatCard 
          label="不合规" 
          count={stats.non_compliant || 0} 
          color="red"
          icon="✗"
        />
        <StatCard 
          label="不适用" 
          count={stats.not_applicable || 0} 
          color="gray"
          icon="○"
        />
        <StatCard 
          label="待确认" 
          count={stats.uncertain || 0} 
          color="orange"
          icon="⚠"
        />
      </div>
    </div>
  );
}

function StatCard({ label, count, color, icon }) {
  return (
    <div className={`bg-${color}-50 border border-${color}-200 rounded-lg p-4`}>
      <div className="text-3xl font-bold text-${color}-600">
        {icon} {count}
      </div>
      <div className="text-sm text-gray-600 mt-1">{label}</div>
    </div>
  );
}
```

