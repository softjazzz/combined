### 3.2 批量接口实现（性能优化层）

```python
class BatchQCService:
    """
    批量质控服务 - 性能优化在此，但判定逻辑使用统一引擎
    """
    
    def __init__(self, engine: UnifiedRuleEngine):
        self.engine = engine
    
    def batch_qc(
        self, 
        records: List[Dict], 
        rule_ids: List[str]
    ) -> List[Dict]:
        """
        批量质控入口
        
        优化策略：
        1. 预先过滤不适用的规则（代码判断，零成本）
        2. 证据缓存复用
        3. 规则分组并发执行
        """
        results = []
        
        for record in records:
            # 优化1：预先过滤不适用的规则
            applicable_rules = self._filter_applicable_rules(record, rule_ids)
            
            # 优化2：启用缓存
            self.engine.evidence_cache.clear()  # 每个病历清空缓存
            
            # 优化3：并发执行（可选）
            for rule_id in rule_ids:
                if rule_id in applicable_rules:
                    # 使用统一引擎，启用缓存
                    result = self.engine.execute_rule(
                        record, 
                        rule_id, 
                        use_cache=True
                    )
                else:
                    # 直接返回不适用（已通过代码判断）
                    result = applicable_rules[rule_id]  # 包含不适用原因
                
                results.append(result)
        
        return results
    
    def _filter_applicable_rules(
        self, 
        record: Dict, 
        rule_ids: List[str]
    ) -> Dict[str, Dict]:
        """
        预先过滤出适用的规则
        不适用的规则直接返回结果，不进LLM
        """
        applicable = {}
        
        for rule_id in rule_ids:
            rule_config = self.engine.config.get_rule(rule_id)
            is_applicable, reason, method = self.engine.applicability_checker.check(
                record, 
                rule_config
            )
            
            if is_applicable:
                applicable[rule_id] = None  # 标记为需要检查
            else:
                # 不适用的规则直接返回结果
                applicable[rule_id] = {
                    "rule_id": rule_id,
                    "status": "not_applicable",
                    "applicability": {
                        "is_applicable": False,
                        "reason": reason,
                        "method": method
                    },
                    "evidence": [],
                    "confidence": 1.0,
                    "reason": reason,
                    "metadata": {"shortcut": True, "tokens_used": 0}
                }
        
        return applicable


class SingleRuleTestService:
    """
    单条测试服务 - 直接使用统一引擎，不做额外优化
