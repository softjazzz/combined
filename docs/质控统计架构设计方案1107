## 三、代码实现（可直接使用）

### 3.1 核心：统一规则引擎

```python
from typing import Dict, List, Optional, Tuple
from dataclasses import dataclass
import re

@dataclass
class RuleConfig:
    rule_id: str
    rule_name: str
    applicable_departments: List[str]
    age_range: Optional[Tuple[int, int]]  # 年龄范围（月）
    applicable_gender: Optional[List[str]]
    check_points: List[str]
    evidence_keywords: List[str]
    risk_level: str  # high/medium/low


class UnifiedRuleEngine:
    """
    统一规则引擎 - 所有质控都走这个引擎
    批量和单条的差异只在调用方式，判定逻辑100%一致
    """
    
    def __init__(self, llm_client, config_loader):
        self.llm = llm_client
        self.config = config_loader
        self.applicability_checker = ApplicabilityChecker()
        self.evidence_verifier = EvidenceVerifier()
        self.evidence_cache = {}  # 性能优化：证据缓存
    
    def execute_rule(
        self, 
        medical_record: Dict, 
        rule_id: str,
        use_cache: bool = True
    ) -> Dict:
        """
        执行单条规则检查
        
        Args:
            medical_record: 病历数据
            rule_id: 规则ID
            use_cache: 是否使用缓存（批量时启用）
        
        Returns:
            标准化的检查结果
        """
        rule_config = self.config.get_rule(rule_id)
        
        # ===== 步骤1：适用性判断（代码优先，极速） =====
        is_applicable, reason, method = self.applicability_checker.check(
            medical_record, 
            rule_config
        )
        
        if not is_applicable:
            return {
                "rule_id": rule_id,
                "status": "not_applicable",
                "applicability": {
                    "is_applicable": False,
                    "reason": reason,
                    "method": method
                },
                "evidence": [],
                "confidence": 1.0,
                "reason": reason,
                "metadata": {"shortcut": True, "tokens_used": 0}
            }
        
        # ===== 步骤2：证据检索（支持缓存） =====
        cache_key = f"{medical_record['id']}:{rule_id}"
        
        if use_cache and cache_key in self.evidence_cache:
            evidence_candidates = self.evidence_cache[cache_key]
        else:
            evidence_candidates = self._extract_evidence_candidates(
                medical_record['content'],
                rule_config.evidence_keywords
            )
            if use_cache:
                self.evidence_cache[cache_key] = evidence_candidates
        
        # ===== 步骤3：LLM 语义检查 =====
        llm_result = self._call_llm_checker(
            medical_record,
            rule_config,
            evidence_candidates
        )
        
        # ===== 步骤4：证据校验（防幻觉） =====
        verified_evidence = self.evidence_verifier.verify(
            llm_result['evidence'],
            medical_record['content']
        )
        
        # ===== 步骤5：结果裁决 =====
        final_result = self._make_decision(
            rule_config,
            llm_result,
            verified_evidence
        )
        
        return final_result
    
    def _extract_evidence_candidates(
        self, 
        text: str, 
        keywords: List[str]
    ) -> List[Dict]:
        """
        提取可能的证据片段
        使用关键词匹配 + 上下文窗口
        """
        candidates = []
        for keyword in keywords:
            # 查找关键词位置
            for match in re.finditer(keyword, text, re.IGNORECASE):
                start = max(0, match.start() - 100)
                end = min(len(text), match.end() + 100)
                candidates.append({
                    "text": text[start:end],
                    "keyword": keyword,
                    "span": (start, end)
                })
        return candidates
    
    def _call_llm_checker(
        self, 
        record: Dict, 
        rule: RuleConfig,
        candidates: List[Dict]
    ) -> Dict:
        """
        调用 LLM 进行语义检查
        使用统一的 Prompt 和严格约束
        """
        prompt = f"""
你是医疗质控专家。请严格检查以下病历是否符合规则。

【规则】{rule.rule_name} ({rule.rule_id})

【检查要点】
{chr(10).join(f"{i+1}. {point}" for i, point in enumerate(rule.check_points))}

【约束条件】
1. 禁止编造证据：所有证据必须来自下方的候选片段
2. 禁止推理：不要根据其他信息推断缺失内容
3. 如实报告：缺少即报缺少

【候选证据片段】
{chr(10).join(f"片段{i+1}: {c['text']}" for i, c in enumerate(candidates))}

请返回 JSON 格式：
{{
    "is_compliant": true/false,
    "evidence": ["证据1原文", "证据2原文"],  // 必须从候选片段中选择
    "missing_items": ["缺失项1"],
    "reason": "简要说明"
}}
"""
        
        response = self.llm.create_completion(
            prompt=prompt,
            temperature=0.1,  # 低温度保证稳定性
            response_format={"type": "json_object"}
        )
        
        return response
    
    def _make_decision(
        self, 
        rule: RuleConfig,
        llm_result: Dict,
        verified_evidence: List[Dict]
    ) -> Dict:
        """
        综合 LLM 结果和证据校验，做最终裁决
        """
        # 计算证据验证率
        total_evidence = len(llm_result['evidence'])
        verified_count = sum(1 for e in verified_evidence if e['verified'])
        verification_rate = verified_count / total_evidence if total_evidence > 0 else 0
        
        # 裁决逻辑
        if verification_rate < 0.5:
            # 证据验证率低，存在幻觉风险
            status = "uncertain"
            confidence = 0.3
            reason = "⚠️ LLM返回的证据未在原文中找到，可能存在幻觉"
        elif llm_result['is_compliant'] and verification_rate >= 0.8:
            status = "compliant"
            confidence = 0.9 * verification_rate
            reason = "符合规则要求"
        elif not llm_result['is_compliant']:
            status = "non_compliant"
            confidence = 0.85
            reason = llm_result.get('reason', '存在缺失项')
        else:
            status = "uncertain"
            confidence = 0.6
            reason = "证据不完整，建议人工复核"
        
        return {
            "rule_id": rule.rule_id,
            "status": status,
            "applicability": {
                "is_applicable": True,
                "reason": "通过适用性检查",
                "method": "code_check"
            },
            "evidence": verified_evidence,
            "confidence": confidence,
            "reason": reason,
            "metadata": {
                "verification_rate": verification_rate,
                "llm_result": llm_result
            }
        }


class ApplicabilityChecker:
    """
    适用性判断器 - 优先使用代码判断，避免 LLM
    """
    
    def check(
        self, 
        record: Dict, 
        rule: RuleConfig
    ) -> Tuple[bool, str, str]:
        """
        返回：(是否适用, 原因, 判断方法)
        """
        # 检查年龄
        if rule.age_range:
            age_months = self._parse_age(record.get('patient_age'))
            min_age, max_age = rule.age_range
            
            if age_months is not None:
                if not (min_age <= age_months <= max_age):
                    return (
                        False, 
                        f"患者年龄{age_months}月，不在适用范围({min_age}-{max_age}月)",
                        "code_check"
                    )
        
        # 检查科室
        if rule.applicable_departments:
            dept = record.get('department', '')
            if dept not in rule.applicable_departments:
                return (
                    False,
                    f"患者科室为'{dept}'，规则仅适用于{rule.applicable_departments}",
                    "code_check"
                )
        
        # 检查性别
        if rule.applicable_gender:
            gender = record.get('gender', '')
            if gender not in rule.applicable_gender:
                return (
                    False,
                    f"患者性别为'{gender}'，规则仅适用于{rule.applicable_gender}",
                    "code_check"
                )
        
        return (True, "符合适用条件", "code_check")
    
    def _parse_age(self, age_str: str) -> Optional[int]:
        """解析年龄字符串为月数"""
        if not age_str:
            return None
        
        # 匹配各种年龄格式
        patterns = [
            (r'(\d+)岁', lambda y: int(y) * 12),
            (r'(\d+)个?月', lambda m: int(m)),
            (r'(\d+)Y', lambda y: int(y) * 12),
            (r'(\d+)M', lambda m: int(m)),
        ]
        
        for pattern, converter in patterns:
            match = re.search(pattern, age_str)
            if match:
                return converter(match.group(1))
        
        return None


class EvidenceVerifier:
    """
    证据校验器 - 防止 LLM 幻觉
    """
    
    def verify(
        self, 
        llm_evidences: List[str], 
        original_text: str
    ) -> List[Dict]:
        """
        校验 LLM 返回的证据是否在原文中存在
        """
        verified_results = []
        
        for evidence in llm_evidences:
            # 方法1：精确匹配
            if evidence in original_text:
                verified_results.append({
                    "text": evidence,
                    "verified": True,
                    "method": "exact_match",
                    "score": 1.0
                })
                continue
            
            # 方法2：标准化后匹配（去除空格、标点）
            normalized_evidence = self._normalize_text(evidence)
            normalized_original = self._normalize_text(original_text)
            
            if normalized_evidence in normalized_original:
                verified_results.append({
                    "text": evidence,
                    "verified": True,
                    "method": "normalized_match",
                    "score": 0.95
                })
                continue
            
            # 方法3：模糊匹配（使用编辑距离）
            similarity = self._fuzzy_match(evidence, original_text)
            if similarity > 0.85:
                verified_results.append({
                    "text": evidence,
                    "verified": True,
                    "method": "fuzzy_match",
                    "score": similarity
                })
            else:
                # 未通过验证
                verified_results.append({
                    "text": evidence,
                    "verified": False,
                    "method": "not_found",
                    "score": similarity,
                    "warning": "⚠️ 此证据可能是LLM幻觉"
                })
        
        return verified_results
    
    def _normalize_text(self, text: str) -> str:
        """文本标准化"""
        text = re.sub(r'[\s\u3000\xa0]+', '', text)  # 去除所有空白
        text = re.sub(r'[，。、；：！？""''【】《》（）]', '', text)  # 去除标点
        return text.lower()
    
    def _fuzzy_match(self, evidence: str, text: str) -> float:
        """模糊匹配（简化版，实际可用 difflib）"""
        # 这里简化实现，实际应使用 SequenceMatcher
        words = evidence.split()
        found_words = sum(1 for w in words if w in text)
        return found_words / len(words) if words else 0.0
